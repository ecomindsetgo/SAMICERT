rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function esAdministrador() {
      return request.auth != null &&
        request.auth.uid == "OCsKdrDfB6h0Ey5RLjiWnvoOWqs1";
    }

    function esCertificador() {
      return request.auth != null &&
        (
          request.auth.uid == "wBCSJ3XfHVaUZPLmC2yJddh5RXx1" ||
          request.auth.uid == "4tdNYgErvlM7NB3hwP933avL3RT2"
        );
    }

    match /usuarios/{uid} {
      allow read: if esAdministrador() || (esCertificador() && request.auth.uid == uid);

      allow create: if
        (esAdministrador() && request.auth.uid == uid) ||
        (esCertificador() && request.auth.uid == uid);

      allow update: if
        (esAdministrador() && request.auth.uid == uid) ||
        (esCertificador() && request.auth.uid == uid);

      allow delete: if false;
    }

    match /certificaciones/{certificacionId} {
      // "get" (documento puntual, por su ID exacto) es público: es lo que
      // usa la página de verificación (verificar.html) a la que apunta el
      // QR impreso en la carátula. Conocer el ID no es un secreto: está
      // impreso en el propio documento certificado.
      //
      // "list" (recorrer/consultar la colección completa) sigue exigiendo
      // sesión de certificador o administrador. Sin esta separación, abrir
      // "read" completo habilitaría además enumerar todas las
      // certificaciones sin autenticarse, que es lo que NO se quiere.
      allow get: if true;
      allow list: if esAdministrador() || esCertificador();

      allow create: if esCertificador()
        && request.resource.data.certificadorUid == request.auth.uid;

      allow update: if false;
      allow delete: if esAdministrador();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
