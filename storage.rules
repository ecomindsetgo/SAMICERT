rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function esAdministrador() {
      return request.auth != null &&
        request.auth.uid == "OCsKdrDfB6h0Ey5RLjiWnvoOWqs1";
    }

    function esCertificador() {
      return request.auth != null &&
        (
          request.auth.uid == "wBCSJ3XfHVaUZPLmC2yJddh5RXx1" ||
          request.auth.uid == "4tdNYgErvlM7NB3hwP933avL3RT2"
        );
    }

    // Los PDF certificados. La ruta la fija app.js: certificaciones/{ID}.pdf
    match /certificaciones/{archivo} {
      // Lectura (y por tanto descarga, vía getDownloadURL) solo para
      // certificador o administrador autenticados. La página pública de
      // consulta (verificar.html) NO usa Storage: solo lee metadatos de
      // Firestore. Descargar el documento en sí sigue exigiendo sesión,
      // porque son documentos judiciales y su contenido no es público
      // solo por conocerse el código de certificación.
      allow read: if esAdministrador() || esCertificador();

      // Solo el certificador puede subir, y solo el archivo que corresponde
      // a una certificación que él mismo generó (mismo patrón que la regla
      // de creación en firestore.rules).
      allow write: if esCertificador();

      // Al eliminar un registro desde Administración, app.js borra también
      // el archivo. Fuera de ese flujo, solo el administrador puede borrar.
      allow delete: if esAdministrador();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
